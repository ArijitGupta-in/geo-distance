{
    "name": "@arijitgupta/geo-distance",
    "version": "2.1.0",
    "description": "Estimate great-circle distances between geographic coordinates in meters, kilometers, miles, or feet using the Haversine formula, with decimal-degree and DMS support.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/ArijitGupta-in/geo-distance.git"
    },
    "homepage": "https://github.com/ArijitGupta-in/geo-distance",
    "bugs": {
        "url": "https://github.com/ArijitGupta-in/geo-distance/issues"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
        "prepublishOnly": "npm run check && npm run test:coverage && npm run build"
    },
    "keywords": [
        "geo",
        "geospatial",
        "distance",
        "coordinates",
        "haversine",
        "great-circle",
        "latitude",
        "longitude",
        "dms",
        "geography",
        "kilometers",
        "miles",
        "feet",
        "nautical-miles",
        "distance-conversion"
    ],
    "author": "Arijit Gupta",
    "license": "MIT",
    "dependencies": {
        "@arijitgupta/geo-core": "^1.0.0"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.11",
        "markdownlint-cli2": "^0.23.2",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
