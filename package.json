{
    "name": "@arijitgupta/geo-distance",
    "version": "1.1.0",
    "description": "Estimate great-circle distances between geographic coordinates in meters, kilometers, miles, or feet using the Haversine formula, with decimal-degree and DMS support.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/ArijitGupta-in/geo-distance.git"
    },
    "homepage": "https://github.com/ArijitGupta-in/geo-distance",
    "bugs": {
        "url": "https://github.com/ArijitGupta-in/geo-distance/issues"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "check": "tsc --noEmit",
        "prepublishOnly": "npm run check && npm test && npm run build"
    },
    "keywords": [
        "geo",
        "geospatial",
        "distance",
        "coordinates",
        "haversine",
        "great-circle",
        "latitude",
        "longitude",
        "dms",
        "geography",
        "kilometers",
        "miles",
        "feet",
        "distance-conversion"
    ],
    "author": "Arijit Gupta",
    "license": "MIT",
    "devDependencies": {
        "markdownlint-cli2": "^0.23.2",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
